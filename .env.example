# ==============================================================================
# CMADMS — Campus Movement & Absence Detection Management System
# Production & Docker Environment Variables Example
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# Do NOT commit sensitive keys or real passwords to version control.
# ==============================================================================

# Node Environment & Server Ports
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Connection (Docker Compose internal network: 'postgres')
# For host-machine local access outside Docker, use localhost:5434
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/cmadms_db

# PostgreSQL Docker Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=cmadms_db
POSTGRES_PORT=5434

# Security Session Secret (Must be >= 32 characters in production)
# Generate a secure random secret using: openssl rand -base64 32
SESSION_SECRET=your-secure-production-session-secret-at-least-32-chars

# Institutional Configuration
COLLEGE_EMAIL_DOMAIN=college.edu.in
INITIAL_PASSWORD=CmadmsInitial@2026
TEMP_PASSWORD_EXPIRES_HOURS=72

# Email / SMTP Notification Settings (Optional in local development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@cmadms.edu
SMTP_PASS=your-smtp-password-here

# pgAdmin (Optional tool profile: docker compose --profile tools up)
PGADMIN_EMAIL=admin@cmadms.com
PGADMIN_PASSWORD=adminpassword
PGADMIN_PORT=5051