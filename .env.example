# CMADMS — Campus Movement & Absence Detection Management System
# Environment Variable Configuration Template (.env.example)
# Copy this file to .env and set your environment values.

# 1. PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Default Docker port: 5434 (cmadms_postgres container) or 5432 for default local PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5434/cmadms_db"

# 2. Server Session Secret Key
# Must be a secret string of at least 32 characters in production environments
SESSION_SECRET="cmadms_production_super_secure_random_session_secret_key_2026_x9k2"

# 3. Application Execution Environment
# Allowed values: "development" | "production" | "test"
NODE_ENV="development"